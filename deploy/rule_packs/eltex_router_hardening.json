    {
      "title": "Eltex ESR SNMP access configuration",
      "vendor_code": "eltex_esr",
      "logic_type": "composite_check",
      "logic_payload": {
        "conditions": [
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^snmp-server\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^snmp-server\\s+dscp\\s+16\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^snmp-server\\s+location\\s+\\S+\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^snmp-server\\s+user\\s+\\S+\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "block_match",
            "payload": {
              "parent_block_start": "^\\s*snmp-server\\s+user\\s+\\S+\\s*$",
              "child_rules": [
                {"pattern": "^\\s*access\\s+\\S+\\s*$", "mode": "must_exist"},
                {"pattern": "^\\s*authentication\\s+algorithm\\s+sha1\\s*$", "mode": "must_exist"},
                {"pattern": "^\\s*authentication\\s+access\\s+auth\\s*$", "mode": "must_exist"},
                {"pattern": "^\\s*authentication\\s+key\\s+ascii-text\\s+.+$", "mode": "must_exist"},
                {"pattern": "^\\s*(?:no\\s+)?client-list\\s+\\S+\\s*$", "mode": "must_exist"},
                {"pattern": "^\\s*enable\\s*$", "mode": "must_exist"}
              ],
              "logic": "ALL"
            }
          }
        ],
        "operator": "all"
      },
      "severity": "high",
      "description": "Проверяет SNMP-сервер, DSCP, location и SNMP user block с auth sha1, key, client-list и enable.",
      "remediation": "snmp-server\nsnmp-server dscp 16\nsnmp-server location <location>\nsnmp-server user <user>\n access <TYPE>\n authentication algorithm sha1\n authentication access auth\n authentication key ascii-text <key>\n [no] client-list <NAME>\n enable"
    },
