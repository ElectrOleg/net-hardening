{
  "version": "1.0",
  "_comment": "HCS Rule Pack: Eltex MES Switch Hardening Checks",
  "rules": [
    {
      "title": "Eltex MES hostname format",
      "vendor_code": "eltex_mes",
      "logic_type": "simple_match",
      "logic_payload": {
        "pattern": "^hostname\\s+S-MOW-\\S+-\\d+\\s*$",
        "match_mode": "must_exist",
        "is_regex": true
      },
      "severity": "medium",
      "description": "Имя коммутатора должно соответствовать стандарту: S-MOW-{location}-{num}.",
      "remediation": "hostname S-MOW-<location>-<num>"
    },
    {
      "title": "Eltex MES warning login banner",
      "vendor_code": "eltex_mes",
      "logic_type": "simple_match",
      "logic_payload": {
        "pattern": "^banner\\s+login\\s+\\^C\\s*$",
        "match_mode": "must_exist",
        "is_regex": true
      },
      "severity": "medium",
      "description": "На коммутаторе должен быть настроен предупреждающий баннер при входе.",
      "remediation": "banner login ^C\n<warning banner text>\n^C"
    },
    {
      "title": "Eltex MES AAA, TACACS and local users",
      "vendor_code": "eltex_mes",
      "logic_type": "composite_check",
      "logic_payload": {
        "conditions": [
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^aaa\\s+authentication\\s+mode\\s+break\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^aaa\\s+authentication\\s+login\\s+authorization\\s+default\\s+tacacs\\s+local\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^aaa\\s+authentication\\s+login\\s+authorization\\s+LOCAL\\s+local\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^aaa\\s+authentication\\s+login\\s+authorization\\s+TACPLUS\\s+tacacs\\s+local\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^aaa\\s+accounting\\s+login\\s+start-stop\\s+group\\s+tacacs\\+\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^aaa\\s+accounting\\s+commands\\s+stop-only\\s+group\\s+tacacs\\+\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^encrypted\\s+tacacs-server\\s+host\\s+10\\.164\\.96\\.149\\s+key\\s+.+\\s+priority\\s+10\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^encrypted\\s+tacacs-server\\s+host\\s+10\\.164\\.96\\.152\\s+key\\s+.+\\s+priority\\s+20\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^encrypted\\s+tacacs-server\\s+host\\s+172\\.19\\.64\\.56\\s+key\\s+.+\\s+priority\\s+30\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^username\\s+admin\\s+password\\s+.+\\s+privilege\\s+15\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^username\\s+imost\\s+password\\s+.+\\s+privilege\\s+15\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          }
        ],
        "operator": "all"
      },
      "severity": "critical",
      "description": "Проверяет обязательную конфигурацию AAA, TACACS+ серверов и локальных пользователей admin/imost.",
      "remediation": "aaa authentication mode break\naaa authentication login authorization default tacacs local\naaa authentication login authorization LOCAL local\naaa authentication login authorization TACPLUS tacacs local\naaa accounting login start-stop group tacacs+\naaa accounting commands stop-only group tacacs+\nencrypted tacacs-server host 10.164.96.149 key <key> priority 10\nencrypted tacacs-server host 10.164.96.152 key <key> priority 20\nencrypted tacacs-server host 172.19.64.56 key <key> priority 30\nusername admin password <password> privilege 15\nusername imost password <password> privilege 15"
    },
    {
      "title": "Eltex MES SNMPv3 access",
      "vendor_code": "eltex_mes",
      "logic_type": "composite_check",
      "logic_payload": {
        "conditions": [
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^snmp-server\\s+server\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^snmp-server\\s+engineID\\s+local\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^snmp-server\\s+group\\s+snmpv3group\\s+v3\\s+auth\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^encrypted\\s+snmp-server\\s+user\\s+\\S+\\s+snmpv3group\\s+v3\\s+auth\\s+sha\\s+.+\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          }
        ],
        "operator": "all"
      },
      "severity": "high",
      "description": "Проверяет включение SNMP-сервера и наличие SNMPv3-группы snmpv3group с auth sha пользователем.",
      "remediation": "snmp-server server\nsnmp-server engineID local\nsnmp-server group snmpv3group v3 auth\nencrypted snmp-server user <user> snmpv3group v3 auth sha <auth-key>"
    },
    {
      "title": "Eltex MES NTP configuration",
      "vendor_code": "eltex_mes",
      "logic_type": "composite_check",
      "logic_payload": {
        "conditions": [
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^clock\\s+timezone\\s+MSK\\s+\\+3\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^clock\\s+source\\s+ntp\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "set_match",
            "payload": {
              "collect_pattern": "^\\s*ntp\\s+server\\s+(\\S+)\\s*$",
              "capture_group": 1,
              "expected_set": [
                "10.164.91.32",
                "10.164.91.34",
                "10.164.91.36",
                "10.164.91.38"
              ],
              "mode": "superset",
              "case_insensitive": false
            }
          }
        ],
        "operator": "all"
      },
      "severity": "medium",
      "description": "Проверяет часовой пояс MSK, источник времени NTP и обязательные NTP-серверы.",
      "remediation": "clock timezone MSK +3\nclock source ntp\nntp server 10.164.91.32\nntp server 10.164.91.34\nntp server 10.164.91.36\nntp server 10.164.91.38"
    },
    {
      "title": "Eltex MES logging configuration",
      "vendor_code": "eltex_mes",
      "logic_type": "composite_check",
      "logic_payload": {
        "conditions": [
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^logging\\s+host\\s+172\\.31\\.12\\.4\\s+facility\\s+local0\\s+severity\\s+notifications\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^logging\\s+host\\s+172\\.31\\.13\\.4\\s+facility\\s+local0\\s+severity\\s+notifications\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^logging\\s+host\\s+10\\.164\\.100\\.151\\s+port\\s+8020\\s+facility\\s+local0\\s+severity\\s+notifications\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^logging\\s+buffered\\s+debugging\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^logging\\s+cli-commands\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^logging\\s+origin-id\\s+hostname\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^logging\\s+aggregation\\s+on\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          }
        ],
        "operator": "all"
      },
      "severity": "high",
      "description": "Проверяет обязательные syslog-серверы и локальные параметры логирования.",
      "remediation": "logging host 172.31.12.4 facility local0 severity notifications\nlogging host 172.31.13.4 facility local0 severity notifications\nlogging host 10.164.100.151 port 8020 facility local0 severity notifications\nlogging buffered debugging\nlogging cli-commands\nlogging origin-id hostname\nlogging aggregation on"
    },
    {
      "title": "Eltex MES domain and DNS configuration",
      "vendor_code": "eltex_mes",
      "logic_type": "composite_check",
      "logic_payload": {
        "conditions": [
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^ip\\s+domain\\s+name\\s+\\S+\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^ip\\s+name-server\\s+172\\.17\\.145\\.60\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          }
        ],
        "operator": "all"
      },
      "severity": "medium",
      "description": "Проверяет имя DNS-домена устройства и обязательный DNS-сервер.",
      "remediation": "ip domain name <domain>\nip name-server 172.17.145.60"
    },
    {
      "title": "Eltex MES SSH server enabled",
      "vendor_code": "eltex_mes",
      "logic_type": "simple_match",
      "logic_payload": {
        "pattern": "^ip\\s+ssh\\s+server\\s*$",
        "match_mode": "must_exist",
        "is_regex": true
      },
      "severity": "high",
      "description": "SSH-сервер должен быть включен на устройстве.",
      "remediation": "ip ssh server"
    },
    {
      "title": "Eltex MES telnet server disabled",
      "vendor_code": "eltex_mes",
      "logic_type": "simple_match",
      "logic_payload": {
        "pattern": "^no\\s+ip\\s+telnet\\s+server\\s*$",
        "match_mode": "must_exist",
        "is_regex": true
      },
      "severity": "high",
      "description": "Telnet-сервер должен быть явно отключен.",
      "remediation": "no ip telnet server"
    },
    {
      "title": "Eltex MES HTTP and HTTPS services disabled",
      "vendor_code": "eltex_mes",
      "logic_type": "composite_check",
      "logic_payload": {
        "conditions": [
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^no\\s+ip\\s+http\\s+server\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          },
          {
            "section": "_default",
            "checker": "simple_match",
            "payload": {
              "pattern": "^no\\s+ip\\s+http\\s+secure-server\\s*$",
              "match_mode": "must_exist",
              "is_regex": true
            }
          }
        ],
        "operator": "all"
      },
      "severity": "high",
      "description": "HTTP и HTTPS сервисы должны быть явно отключены.",
      "remediation": "no ip http server\nno ip http secure-server"
    },
    {
      "title": "Eltex MES STP rapid-pvst mode",
      "vendor_code": "eltex_mes",
      "logic_type": "simple_match",
      "logic_payload": {
        "pattern": "^spanning-tree\\s+mode\\s+rapid-pvst\\s*$",
        "match_mode": "must_exist",
        "is_regex": true
      },
      "severity": "medium",
      "description": "Для STP должен быть настроен режим rapid-pvst.",
      "remediation": "spanning-tree mode rapid-pvst"
    }
  ]
}
